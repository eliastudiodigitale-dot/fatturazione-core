# Solo nomi, nessun valore. I valori veri stanno in .env (non committato) o nei Secret/ConfigMap k8s.
# Obbligatorie
PG_DB=
APP_PG_USER=
APP_PG_PASS=
PG_SSL=                      # disable | require | verify-full
N8N_TOKEN=                   # min 32 caratteri
DASHBOARD_TOKEN=             # min 32 caratteri
OWNER_TOKEN=                 # min 32 caratteri
# Facoltative (default tra parentesi)
PORT=                        # (8080)
PG_HOST=                     # (services-postgres)
PG_PORT=                     # (5432)
PG_CA_FILE=
FORZA_BLOCCO=                # true dopo un ripristino
BODY_LIMIT=                  # (65536)
RATE_LIMIT_PER_MIN=          # (120)
LOG_LEVEL=                   # (info)
PAGAMENTI_TIPO_DOCUMENTO=    # fattura | proforma; vuoto = webhook di pagamento spenti
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=              # chiave ristretta in sola lettura
STRIPE_LIVEMODE=             # (true) false = accetta solo eventi di test
STRIPE_BUSINESS_PREDEFINITO= # business se l'evento non ha metadata.business
GC_BUSINESS_PREDEFINITO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GC_WEBHOOK_SECRET=
GC_API_TOKEN=
GC_TRIGGER_ACTION=           # confirmed | paid_out
GC_API_URL=
CLICKUP_TOKEN=
CLICKUP_API_URL=
CLICKUP_RPM=                 # (100)
CLICKUP_LIST_ID_FATTURA=
CLICKUP_LIST_ID_PROFORMA=
CLICKUP_CAMPO_CHIAVE_ID=
CLICKUP_CAMPO_NUMERO_ID=
CLICKUP_CAMPO_BUSINESS_ID=
CLICKUP_CAMPO_RATA_ID=
WORKER_INTERNI_SEC=          # (90)
WORKER_ESTERNI_SEC=          # (2700)
RICONCILIAZIONE_ORA=         # (6, ora di Roma)
RISERVATO_MAX_ORE=           # (24)
