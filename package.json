{
  "name": "fatturazione-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck:test": "tsc --noEmit --module nodenext --moduleResolution nodenext --strict --skipLibCheck --target es2023 tests/*.ts tests/setup/*.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
